{
  "project": {
    "name": "Fete Lite",
    "version": "1.1.7",
    "description": "Lekka aplikacja PWA (Progressive Web App) do organizowania wydarzeń towarzyskich. Umożliwia tworzenie, przeglądanie, edytowanie i udostępnianie wydarzeń, z pełną obsługą trybu offline.",
    "language": "pl",
    "type": "PWA (Progressive Web App)",
    "architecture": "Frontend-only (Vanilla JS) z opcjonalnym backendem REST API",
    "primaryColor": "#673ab7",
    "backendUrl": "https://fetebackend-production.up.railway.app/"
  },

  "technologyStack": {
    "frontend": {
      "language": "JavaScript ES6+ (Vanilla, bez frameworków)",
      "markup": "HTML5",
      "styling": "CSS3 z Custom Properties (zmienne CSS), Flexbox, Grid",
      "architecture": "Wzorzec modułowy (Module Pattern) z globalnymi klasami na window"
    },
    "externalLibraries": [
      {
        "name": "Leaflet.js",
        "version": "1.9.4",
        "purpose": "Interaktywne mapy (zamiennik Google Maps)",
        "source": "https://unpkg.com/leaflet@1.9.4/",
        "loadStrategy": "Leniwe ładowanie (tylko gdy potrzebna mapa)"
      },
      {
        "name": "OpenStreetMap",
        "purpose": "Kafelki (tiles) mapy – bezpłatny serwer",
        "source": "https://tile.openstreetmap.org/"
      },
      {
        "name": "QRCode.js",
        "version": "1.5.3",
        "purpose": "Generowanie kodów QR",
        "sources": [
          "https://cdn.jsdelivr.net/npm/qrcode@1.5.3/lib/browser.js",
          "https://unpkg.com/qrcode@1.5.3/lib/browser.js",
          "./js/qrcode.min.js (lokalny fallback)"
        ]
      },
      {
        "name": "Nominatim",
        "purpose": "Geokodowanie i odwrotne geokodowanie adresów",
        "source": "https://nominatim.org/"
      }
    ],
    "browserAPIs": [
      "Service Worker API – obsługa offline i cachowanie",
      "Notification API – powiadomienia push",
      "Geolocation API – wykrywanie lokalizacji użytkownika",
      "LocalStorage API – przechowywanie danych i ustawień",
      "Fetch API – zapytania HTTP z obsługą błędów i retry",
      "Web Crypto API – zarządzanie tokenami JWT",
      "IntersectionObserver API – leniwe ładowanie obrazów"
    ],
    "backend": {
      "type": "Opcjonalny REST API",
      "technology": "PHP 8.0+ / MySQL 8.0+",
      "auth": "JWT (JSON Web Token) z automatycznym odświeżaniem",
      "deployment": "Railway.app (Docker)"
    }
  },

  "directoryStructure": {
    "root": "/",
    "files": {
      "index.html": "Strona główna – lista wydarzeń z wyszukiwaniem i filtrami",
      "create-event.html": "Formularz tworzenia/edycji wydarzeń (wielosekcyjny)",
      "event-details.html": "Szczegóły wydarzenia – mapa, QR kod, eksport do kalendarza",
      "auth.html": "Logowanie i rejestracja użytkownika (JWT)",
      "settings.html": "Ustawienia aplikacji – motyw, język, powiadomienia",
      "clear-cache.html": "Narzędzie do czyszczenia cache (debug)",
      "test-qr.html": "Strona testowa do generowania kodów QR",
      "test-search.html": "Strona testowa wyszukiwarki",
      "manifest.json": "Manifest PWA – konfiguracja instalacji, ikony, skróty",
      "service-worker.js": "Service Worker – cache offline, strategie cachowania",
      "test-integration.js": "Testy integracyjne API",
      "test-registration.json": "Dane testowe do rejestracji",
      "start-dev-server.sh": "Skrypt uruchamiający lokalny serwer deweloperski (Bash)",
      "start-dev-server.ps1": "Skrypt uruchamiający lokalny serwer deweloperski (PowerShell)",
      "README.md": "Główna dokumentacja projektu",
      "MAP_OPTIMIZATION.md": "Dokumentacja optymalizacji ładowania map",
      "ORGANIZER_FEATURE.md": "Dokumentacja systemu organizatora wydarzeń"
    },
    "directories": {
      "js/": "Wszystkie moduły JavaScript aplikacji (~27 plików, ~8000 linii kodu)",
      "css/": "Pliki stylów CSS (~7 plików, ~4500 linii)",
      "images/": "Grafiki – logo, ikony PWA (SVG i PNG)"
    }
  },

  "javascriptModules": {
    "core": [
      {
        "file": "js/config.js",
        "class": "Config",
        "purpose": "Konfiguracja środowiska – automatyczne wykrywanie URL backendu",
        "exports": "window.Config",
        "methods": [
          "Config.getApiUrl() → string – zwraca URL backendu (Railway.app)",
          "Config.isDevelopment() → boolean – czy środowisko deweloperskie (localhost)",
          "Config.isProduction() → boolean",
          "Config.getEnvironment() → 'development' | 'production'"
        ]
      },
      {
        "file": "js/main.js",
        "purpose": "Inicjalizacja aplikacji i koordynacja modułów",
        "role": "Punkt wejścia – ładuje i inicjalizuje wszystkie pozostałe moduły"
      },
      {
        "file": "js/storage.js",
        "class": "Storage",
        "lines": 923,
        "purpose": "Warstwa abstrakcji nad localStorage – zarządzanie danymi lokalnie",
        "exports": "window.Storage",
        "capabilities": [
          "CRUD operacje na wydarzeniach",
          "Offline queue – kolejka operacji do synchronizacji gdy przywrócone połączenie",
          "Zarządzanie ustawieniami",
          "Importowanie i eksportowanie danych"
        ],
        "storageKeys": {
          "events": "fete-lite-events",
          "settings": "fete-lite-settings",
          "offlineQueue": "fete-lite-offline-queue",
          "language": "fete-lite-language",
          "accessToken": "access_token",
          "refreshToken": "refresh_token",
          "notificationSettings": "notificationSettings"
        }
      },
      {
        "file": "js/events.js",
        "purpose": "Logika biznesowa zarządzania wydarzeniami – tworzenie, filtrowanie, sortowanie",
        "exports": "window.EventManager"
      },
      {
        "file": "js/i18n.js",
        "purpose": "System internacjonalizacji – obsługa języka polskiego i angielskiego",
        "exports": "window.i18n",
        "languages": ["pl (domyślny)", "en"],
        "detection": "Automatyczne wykrywanie języka przeglądarki, nadpisane przez ustawienia użytkownika"
      }
    ],
    "apiAndData": [
      {
        "file": "js/api-client.js",
        "class": "ApiClient",
        "purpose": "Klient HTTP REST API z autoryzacją JWT i automatycznym odświeżaniem tokenów",
        "exports": "window.ApiClient",
        "features": [
          "Automatyczne dołączanie nagłówka Authorization: Bearer <token>",
          "Automatyczne odświeżanie wygasłego tokenu JWT",
          "Logika ponowienia (retry) przy błędach sieciowych",
          "Obsługa błędów 401/403"
        ]
      },
      {
        "file": "js/data-adapter.js",
        "class": "DataAdapter",
        "purpose": "Konwersja danych między formatem frontendu (camelCase) a backendem (snake_case)",
        "exports": "window.DataAdapter",
        "methods": [
          "DataAdapter.toBackend(event) – konwertuje event na format API",
          "DataAdapter.fromBackend(apiEvent) – konwertuje odpowiedź API na format frontendu"
        ]
      },
      {
        "file": "js/auth.js",
        "class": "AuthManager",
        "purpose": "Zarządzanie uwierzytelnieniem – logowanie, rejestracja, wylogowanie",
        "exports": "window.AuthManager",
        "endpoints": {
          "login": "POST /api/v1/auth/login",
          "register": "POST /api/v1/auth/register",
          "refreshToken": "POST /api/v1/auth/refresh"
        }
      },
      {
        "file": "js/network.js",
        "lines": 507,
        "purpose": "Monitorowanie stanu sieci – wykrywanie offline/online, zarządzanie kolejką synchronizacji",
        "exports": "window.NetworkManager",
        "features": [
          "Słuchanie zdarzeń online/offline",
          "Automatyczna synchronizacja przy przywróceniu połączenia",
          "Wskaźnik stanu połączenia w UI"
        ]
      },
      {
        "file": "js/sample-data-api.js",
        "lines": 371,
        "purpose": "Ładowanie przykładowych/demonstracyjnych danych wydarzeń",
        "exports": "window.SampleDataAPI"
      }
    ],
    "features": [
      {
        "file": "js/qr.js",
        "lines": 871,
        "purpose": "Generowanie kodów QR dla wydarzeń z mechanizmem fallback dla źródeł biblioteki",
        "exports": "window.QRManager"
      },
      {
        "file": "js/qrcode.min.js",
        "purpose": "Zminifikowana biblioteka QR code – lokalny fallback gdy CDN niedostępny"
      },
      {
        "file": "js/geolocation.js",
        "purpose": "Obsługa geolokalizacji – wykrywanie pozycji, integracja z mapą Leaflet, Nominatim geocoding",
        "exports": "window.GeolocationManager"
      },
      {
        "file": "js/ics-export.js",
        "purpose": "Eksport wydarzeń do formatu iCalendar (.ics) – kompatybilny z Google Calendar, Outlook, Apple Calendar",
        "exports": "window.ICSExporter"
      },
      {
        "file": "js/notifications.js",
        "lines": 531,
        "purpose": "System powiadomień push – zarządzanie uprawnieniami, planowanie przypomnień",
        "exports": "window.NotificationManager",
        "features": [
          "Prośba o uprawnienie do powiadomień",
          "Planowanie przypomnień przed wydarzeniem",
          "Konfigurowalne czasy wyprzedzenia"
        ]
      },
      {
        "file": "js/create-event.js",
        "purpose": "Obsługa formularza tworzenia/edycji wydarzenia – walidacja, przesyłanie danych",
        "exports": "window.CreateEventManager"
      },
      {
        "file": "js/event-details.js",
        "purpose": "Logika strony szczegółów wydarzenia – uprawnienia organizatora, edycja, usuwanie",
        "exports": "window.EventDetailsManager"
      },
      {
        "file": "js/event-themes.js",
        "purpose": "System kategorii/motywów wydarzeń (np. BBQ, urodziny, koncert)",
        "exports": "window.EventThemes"
      }
    ],
    "uiComponents": [
      {
        "file": "js/navigation.js",
        "lines": 244,
        "purpose": "Pasek nawigacji dolnej – aktywne stany, przełączanie widoków",
        "exports": "window.NavigationManager"
      },
      {
        "file": "js/header.js",
        "purpose": "Dynamiczny nagłówek strony – tytuł i przyciski akcji",
        "exports": "window.HeaderManager"
      },
      {
        "file": "js/darkmode.js",
        "purpose": "Przełącznik motywu ciemnego/jasnego z wykrywaniem preferencji systemowych",
        "exports": "window.DarkModeManager"
      },
      {
        "file": "js/mobile-fullscreen.js",
        "lines": 201,
        "purpose": "Tryb pełnoekranowy na urządzeniach mobilnych gdy aplikacja zainstalowana jako PWA",
        "exports": "window.MobileFullscreenManager"
      },
      {
        "file": "js/modern-effects.js",
        "lines": 370,
        "purpose": "Nowoczesne efekty CSS – animacje, przejścia, efekty wizualne",
        "exports": "window.ModernEffects"
      },
      {
        "file": "js/lazy-loading.js",
        "purpose": "Leniwe ładowanie obrazów za pomocą IntersectionObserver",
        "exports": "window.LazyLoader"
      },
      {
        "file": "js/image-optimizer.js",
        "purpose": "Kompresja i optymalizacja obrazów",
        "exports": "window.ImageOptimizer"
      }
    ],
    "system": [
      {
        "file": "js/settings.js",
        "lines": 380,
        "purpose": "Zarządzanie ustawieniami użytkownika – motyw, język, powiadomienia, eksport danych",
        "exports": "window.SettingsManager"
      },
      {
        "file": "js/update-checker.js",
        "lines": 372,
        "purpose": "Sprawdzanie dostępności aktualizacji aplikacji przez Service Worker",
        "exports": "window.UpdateChecker"
      }
    ]
  },

  "cssFiles": [
