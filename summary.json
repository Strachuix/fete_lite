  "dataModel": {
    "eventObject": {
      "description": "Struktura obiektu wydarzenia przechowywana w localStorage",
      "fields": {
        "id": "string – unikalny identyfikator (format: event_<timestamp>_<random>)",
        "title": "string – nazwa wydarzenia",
        "description": "string – opis wydarzenia",
        "startDate": "string – data rozpoczęcia (YYYY-MM-DD)",
        "startTime": "string – godzina rozpoczęcia (HH:MM)",
        "endDate": "string | null – data zakończenia (YYYY-MM-DD)",
        "endTime": "string | null – godzina zakończenia (HH:MM)",
        "location": "string – nazwa miejsca",
        "coordinates": "{ lat: number, lng: number } | null – współrzędne GPS",
        "organizerId": "string – email/ID organizatora",
        "organizerName": "string – imię i nazwisko organizatora",
        "createdAt": "string – data utworzenia (ISO 8601)",
        "updatedAt": "string – data ostatniej edycji (ISO 8601)",
        "theme": "string – kategoria (np. BBQ, urodziny, koncert)",
        "maxParticipants": "number | null – maksymalna liczba uczestników",
        "isPaid": "boolean – czy wydarzenie płatne",
        "price": "number – cena wejścia",
        "currency": "string – waluta (domyślnie PLN)",
        "food": "boolean – czy jest jedzenie",
        "drinks": "boolean – czy są napoje",
        "accommodation": "boolean – czy jest nocleg",
        "parking": "boolean – czy jest parking",
        "pets": "boolean – czy dozwolone zwierzęta",
        "images": "string[] – zdjęcia (base64 lub URL)",
        "qrCode": "string | null – wygenerowany kod QR (base64 PNG)",
        "invitationCode": "string | null – kod zaproszenia do udostępniania",
        "isFavorite": "boolean – czy oznaczone jako ulubione",
        "synced": "boolean – czy zsynchronizowane z backendem",
        "lastSyncError": "string | null – ostatni błąd synchronizacji"
      }
    },
    "backendEventFormat": {
      "description": "Format danych przesyłanych do/z API backendu (snake_case)",
      "fields": {
        "id": "integer",
        "title": "string",
        "description": "string",
        "start_date": "string (ISO 8601 datetime)",
        "end_date": "string (ISO 8601 datetime) | null",
        "location_name": "string",
        "latitude": "number | null",
        "longitude": "number | null",
        "organizer_id": "integer",
        "max_participants": "integer | null",
        "theme": "string",
        "is_paid": "boolean",
        "price": "number",
        "currency": "string",
        "accommodation_available": "boolean",
        "is_public": "boolean",
        "created_at": "string (ISO 8601)",
        "updated_at": "string (ISO 8601)"
      }
    },
    "localStorageKeys": {
      "fete-lite-events": "JSON array – lista wszystkich wydarzeń",
      "fete-lite-settings": "JSON object – ustawienia użytkownika",
      "fete-lite-offline-queue": "JSON array – kolejka operacji oczekujących na synchronizację",
      "fete-lite-language": "string – kod języka (pl/en)",
      "access_token": "string – JWT access token",
      "refresh_token": "string – JWT refresh token",
      "notificationSettings": "JSON object – ustawienia powiadomień"
    }
  },

  "backendAPI": {
    "baseUrl": "https://fetebackend-production.up.railway.app/",
    "version": "v1",
    "authentication": "Bearer Token (JWT)",
    "endpoints": [
      {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "description": "Logowanie użytkownika",
        "body": { "email": "string", "password": "string" },
        "returns": "{ access_token, refresh_token, user }"
      },
      {
        "method": "POST",
        "path": "/api/v1/auth/register",
        "description": "Rejestracja nowego użytkownika",
        "body": { "email": "string", "password": "string", "name": "string" },
        "returns": "{ access_token, refresh_token, user }"
      },
      {
        "method": "POST",
        "path": "/api/v1/auth/refresh",
        "description": "Odświeżenie tokenu JWT",
        "body": { "refresh_token": "string" },
        "returns": "{ access_token }"
      },
      {
        "method": "GET",
        "path": "/api/v1/events",
        "description": "Pobierz wszystkie publiczne wydarzenia",
        "auth": "opcjonalne",
        "returns": "array of event objects"
      },
      {
        "method": "GET",
        "path": "/api/v1/events/:id",
        "description": "Pobierz szczegóły konkretnego wydarzenia",
        "auth": "opcjonalne",
        "returns": "event object"
      },
      {
        "method": "POST",
        "path": "/api/v1/events",
        "description": "Utwórz nowe wydarzenie",
        "auth": "wymagane",
        "body": "event object (snake_case)",
        "returns": "created event object"
      },
      {
        "method": "PUT",
        "path": "/api/v1/events/:id",
        "description": "Zaktualizuj wydarzenie (tylko organizator)",
        "auth": "wymagane",
        "body": "partial event object",
        "returns": "updated event object"
      },
      {
        "method": "DELETE",
        "path": "/api/v1/events/:id",
        "description": "Usuń wydarzenie (tylko organizator)",
        "auth": "wymagane",
        "returns": "{ success: true }"
      },
      {
        "method": "POST",
        "path": "/api/v1/events/:id/register",
        "description": "Zapisz się na wydarzenie",
        "auth": "wymagane",
        "returns": "{ success: true }"
      },
      {
        "method": "GET",
        "path": "/api/v1/users/:id/events",
        "description": "Pobierz wydarzenia danego użytkownika",
        "auth": "wymagane",
        "returns": "array of event objects"
      }
    ]
  },

